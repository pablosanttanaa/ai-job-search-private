[Unit]
Description=Dashboard de ofertas de empleo (ai-job-search)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/ai-job-search
Environment=DASHBOARD_HOST=127.0.0.1
Environment=DASHBOARD_PORT=8095
Environment=PYTHONIOENCODING=utf-8
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 dashboard/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
